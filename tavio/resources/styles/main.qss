/* TAVIO Phase 0 Minimal Desktop Stylesheet */

QMainWindow {
    background-color: #f4f6f9;
}

#Sidebar {
    background-color: #16243b;
    border-right: 1px solid #0f1a2c;
}

#BrandTitle {
    color: #ffffff;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1px;
}

#BrandSubtitle {
    color: #9eb3d1;
    font-size: 12px;
    margin-bottom: 8px;
}

QPushButton#DashboardNavigationButton {
    background-color: transparent;
    color: #dbe6f5;
    border: none;
    border-radius: 6px;
    padding: 10px 12px;
    text-align: left;
    font-size: 13px;
    font-weight: 500;
}

QPushButton#DashboardNavigationButton:hover {
    background-color: #213556;
}

QPushButton#DashboardNavigationButton:pressed {
    background-color: #1c3560;
}

#NavigationTree {
    background-color: transparent;
    border: none;
    color: #dbe6f5;
    font-size: 13px;
    outline: none;
}

#NavigationTree::item {
    padding: 10px 12px;
    border-radius: 6px;
    margin-bottom: 4px;
}

#NavigationTree::item:hover {
    background-color: #213556;
}

#NavigationTree::item:selected {
    background-color: #2f5597;
    color: #ffffff;
    font-weight: 600;
}

#NavigationTree::branch {
    background-color: transparent;
}

#NavigationTree::item {
    min-height: 20px;
}

/* Scroll remains available by mouse wheel; the visual scrollbar is hidden in code. */
#NavigationTree::item:selected {
    outline: none;
}

#PageTitle {
    font-size: 18px;
    font-weight: 700;
    color: #16243b;
}

#SectionTitle {
    font-size: 14px;
    font-weight: 600;
    color: #1e3252;
}

#FieldLabel {
    font-weight: 600;
    color: #34495e;
}

#Card {
    background-color: #ffffff;
    border: 1px solid #d9e1ec;
    border-radius: 8px;
    padding: 12px;
}

QTableWidget {
    background-color: #ffffff;
    border: 1px solid #d9e1ec;
    border-radius: 6px;
    gridline-color: #e6ecf5;
}

QHeaderView::section {
    background-color: #eef2f8;
    color: #16243b;
    font-weight: 600;
    padding: 6px;
    border: none;
    border-bottom: 1px solid #d9e1ec;
}

QPushButton {
    background-color: #2f5597;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 8px 14px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #24447a;
}

QPushButton#SidebarToggle {
    background-color: transparent;
    color: #dbe6f5;
    border: 1px solid #405575;
    border-radius: 6px;
    padding: 0;
    font-size: 20px;
    font-weight: 700;
}

QPushButton#SidebarToggle:hover {
    background-color: #213556;
}

QPushButton:pressed {
    background-color: #1c3560;
}

QPushButton:disabled {
    background-color: #b8c4d6;
    color: #eef2f8;
}

QPushButton#SecondaryButton {
    background-color: #eef2f8;
    color: #16243b;
    border: 1px solid #c5d1e2;
}

QPushButton#SecondaryButton:hover {
    background-color: #e1e8f2;
}

QPushButton#DangerButton {
    background-color: #ffffff;
    color: #b42318;
    border: 1px solid #f0b4ae;
}

QPushButton#DangerButton:hover {
    background-color: #fef3f2;
}

QPushButton#DangerButton:disabled {
    background-color: #f8f9fb;
    color: #b8c4d6;
    border: 1px solid #e2e8f0;
}

QLineEdit,
QPlainTextEdit,
QComboBox {
    background-color: #ffffff;
    color: #16243b;
    border: 1px solid #c8d3e3;
    border-radius: 6px;
    padding: 7px 10px;
    font-size: 13px;
}

QLineEdit:focus,
QPlainTextEdit:focus,
QComboBox:focus {
    border: 1px solid #2f5597;
}

QScrollArea#ProfileScrollArea {
    background-color: transparent;
    border: none;
}

QLabel#HintLabel {
    color: #5b6d82;
    font-size: 12px;
}

QLabel#LogoPreview {
    background-color: #f8fafc;
    border: 1px dashed #b9c7da;
    border-radius: 8px;
    color: #64748b;
    font-size: 12px;
    padding: 8px;
}

QLabel#StatusBannerSuccess {
    background-color: #ecfdf3;
    color: #067647;
    border: 1px solid #abefc6;
    border-radius: 6px;
    padding: 8px 10px;
    font-size: 12px;
}

QLabel#StatusBannerError {
    background-color: #fef3f2;
    color: #b42318;
    border: 1px solid #fecdca;
    border-radius: 6px;
    padding: 8px 10px;
    font-size: 12px;
}
